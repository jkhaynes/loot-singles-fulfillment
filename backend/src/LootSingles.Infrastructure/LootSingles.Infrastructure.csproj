<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="..\LootSingles.Application\LootSingles.Application.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="CardCatalog\Data\pokemon-series-abbreviations.json" />
        <EmbeddedResource Include="CardCatalog\Data\tcgplayer-magic-to-scryfall-set-codes.json" />
        <Content Include="CardCatalog\Data\tcgplayer-magic-to-scryfall-set-codes.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- Cookie authentication types (EmployeeSessionCookieEvents) live in the shared ASP.NET Core
         framework rather than a NuGet package; this library isn't Sdk.Web, so it needs an explicit
         FrameworkReference to see them. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <!-- Data Protection key persistence (019 research.md #5). Microsoft.AspNetCore.DataProtection
         itself is in the ASP.NET Core shared framework referenced below, but the EF Core key-storage
         provider is a separate package, so this reference is required rather than redundant. It lives
         here, not in LootSingles.Api, because LootSinglesDbContext implements IDataProtectionKeyContext;
         the API reaches it transitively.

         Pinned to 10.0.12, not 10.0.0 like the EF Core packages above. 10.0.0 drags in
         Microsoft.AspNetCore.DataProtection 10.0.0, which carries a CRITICAL advisory
         (GHSA-9mv3-2cwr-p262) plus a HIGH one on System.Security.Cryptography.Xml. Both reach the
         test projects transitively, which resolve them from NuGet rather than the shared framework.
         Before this reference existed, a NuGet vulnerability audit reported zero findings across all
         eight projects; keeping it that way is the reason for the version bump. -->
        <PackageReference
            Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore"
            Version="10.0.12"
        />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
        <!-- Microsoft.Extensions.Identity.Core (PasswordHasher<T>, research.md #1) is now part of the
         ASP.NET Core shared framework this project already references below, so .NET 10's NuGet
         package pruning rejects an explicit PackageReference to it (NU1510) as redundant. -->
        <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <UserSecretsId>loot-singles-fulfillment-api</UserSecretsId>
    </PropertyGroup>
</Project>
